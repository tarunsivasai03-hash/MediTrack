# Copy to .env and fill in. Never commit the real .env.

# Required in production: a long random string, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# Behind nginx / Caddy / a load balancer: trust X-Forwarded-* headers (client IPs, https)
TRUST_PROXY=1

# The hospital's time zone (slots, "today", check-ins). Containers run in UTC, so set this.
TIMEZONE=Asia/Kolkata

# Force admins, doctors and reception to set up two-factor login
REQUIRE_2FA=0

# Email (leave MAIL_SERVER empty to log emails instead of sending them)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=MediTrack <no-reply@example.com>
SESSION_COOKIE_SECURE=1
